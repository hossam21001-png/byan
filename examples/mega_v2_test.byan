انا_برنامج
    اسمي: الاختبار الشامل V2

الكود:
    انشئ نافذة:
        العنوان: الاختبار V2
        لون_الخلفية: بنفسجي

    انشئ عنوانا:
        النص: الاختبار الشامل V2
        الحجم: 24
        اللون: أسود

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة هتظهر هنا"
        الحجم: 20
        اللون: أسود

    انشئ زر:
        المعرف: "b1"
        النص: "دمج النصوص"
        اللون: أخضر
        عند_الضغط:
            متغير اسم = "احمد"
            متغير عمر = 25
            اعرض_في "أهلاً يا {اسم} عمرك {عمر} سنة" في: "#out"

    انشئ زر:
        المعرف: "b2"
        النص: "دوال المصفوفات"
        اللون: برتقالي
        عند_الضغط:
            متغير ارقام = [3, 1, 4, 2, 5]
            اعرض_في رتب(ارقام) في: "#out"

    انشئ زر:
        المعرف: "b3"
        النص: "تحويلات"
        اللون: أزرق
        عند_الضغط:
            متغير رقم_نص = "42"
            متغير الرقم = رقم(رقم_نص)
            اعرض_في الرقم + 8 في: "#out"

    انشئ زر:
        المعرف: "b4"
        النص: "حاول لو_فشل"
        اللون: أحمر
        عند_الضغط:
            حاول:
                اقرأ "غير_موجود.txt" في: "#out"
            لو_فشل:
                اعرض_في "الملف مش موجود!" في: "#out"

    انشئ زر:
        المعرف: "b5"
        النص: "انتظر + DB"
        اللون: بنفسجي
        عند_الضغط:
            انتظر:
                اضف_سجل "test" فيه {name: "محمد"}
                اقرأ_سجلات "test" في: "#out"
