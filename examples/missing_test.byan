انا_برنامج
    اسمي: اختبار النواقص

الكود:
    انشئ نافذة:
        العنوان: اختبار النواقص
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: اختبار الميزات الجديدة
        الحجم: 22

    انشئ زر:
        المعرف: "b1"
        النص: "اختبر توقف"
        عند_الضغط:
            لكل رقم في [1, 2, 3, 4, 5]:
                لو رقم == 3:
                    توقف
                اعرض_في رقم في: "#out"

    انشئ زر:
        المعرف: "b2"
        النص: "اختبر استمر"
        عند_الضغط:
            لكل رقم في [1, 2, 3, 4, 5]:
                لو رقم == 3:
                    استمر
                اعرض_في رقم في: "#out"

    انشئ زر:
        المعرف: "b3"
        النص: "اختبر وإلا لو"
        عند_الضغط:
            متغير درجة = 75
            لو درجة >= 90:
                اعرض_في "ممتاز" في: "#out"
            وإلا لو درجة >= 75:
                اعرض_في "جيد جدًا" في: "#out"
            وإلا لو درجة >= 50:
                اعرض_في "مقبول" في: "#out"
            وإلا:
                اعرض_في "راسب" في: "#out"

    انشئ زر:
        المعرف: "b4"
        النص: "اختبر مصفوفة 2D"
        عند_الضغط:
            متغير مصفوفة = [[1, 2], [3, 4], [5, 6]]
            اعرض_في مصفوفة[0][1] في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
