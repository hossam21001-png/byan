# ملف تجريبي - Hello World بلغة بيان

انا_برنامج
    اسمي: "تجربتي"
    وظيفتي: "عرض رسالة ترحيب"
    أنظمة_التشغيل: "الكل"

الكود:
    أنشئ_ملفًا:
        الاسم: "index.html"
        المسار: "./"
        المحتوى:
            """
            <!DOCTYPE html>
            <html lang="ar" dir="rtl">
            <head>
                <meta charset="UTF-8">
                <title>تجربتي</title>
                <link rel="stylesheet" href="style.css">
            </head>
            <body>
                <h1>مرحبًا بك في بيان</h1>
                <p>أول برنامج بلغة بيان</p>
                <button id="btn">اضغطني</button>
                <p id="output"></p>
                <script src="script.js"></script>
            </body>
            </html>
            """

    أنشئ_ملفًا:
        الاسم: "style.css"
        المسار: "./"
        المحتوى:
            """
            body {
                font-family: 'Cairo', 'Tahoma', sans-serif;
                background: linear-gradient(135deg, #667eea, #764ba2);
                color: white;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
                padding: 20px;
            }
            h1 { font-size: 42px; margin-bottom: 10px; }
            button {
                padding: 15px 40px;
                font-size: 20px;
                border-radius: 12px;
                border: none;
                cursor: pointer;
                background: #fff;
                color: #667eea;
                font-weight: bold;
                margin-top: 20px;
            }
            #output {
                font-size: 28px;
                margin-top: 30px;
                min-height: 40px;
            }
            """

    أنشئ_ملفًا:
        الاسم: "script.js"
        المسار: "./"
        المحتوى:
            """
            console.log('بيان يعمل!');
            """

    أنشئ زر:
        المعرف: "btn"
        النص: "اضغطني"
        عند_الضغط:
            اعرض_في "أهلاً بالعالم 👋" في: "#output"
