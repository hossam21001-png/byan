انا_برنامج
    اسمي: "اختبار DEDENT"

الكود:
    دالة حساب(س):
        لو س > 10:
            اعرض_في "كبير" في: "#out"
        وإلا:
            اعرض_في "صغير" في: "#out"
        ارجع س * 2

    دالة خارجية(س):
        دالة داخلية(ص):
            لو ص > 0:
                ارجع ص
            وإلا:
                ارجع -ص
        ارجع داخلية(س) + 10

    انشئ نافذة:
        العنوان: "DEDENT"
        لون_الخلفية: أزرق

    انشئ زر:
        المعرف: "btn1"
        النص: "اختبر"
        اللون: أخضر
        عند_الضغط:
            متغير ن = خارجية(-5)
            اعرض_في "النتيجة: {ن}" في: "#out"

    انشئ زر:
        المعرف: "btn2"
        النص: "اختبر تاني"
        اللون: برتقالي
        عند_الضغط:
            اعرض_في "مرحبا" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أسود
