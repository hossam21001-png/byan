انا_برنامج
    اسمي: اختبار قاعدة البيانات

الكود:
    انشئ نافذة:
        العنوان: قاعدة البيانات
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: اختبار قاعدة البيانات
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "create_table"
        النص: "أضف سجل جديد"
        اللون: أخضر
        عند_الضغط:
            اضف_سجل "users" فيه {name: "احمد", age: 25}
            اقرأ_سجلات "users" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة هتظهر هنا"
        الحجم: 20
        اللون: أسود
