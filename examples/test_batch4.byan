    انشئ عنوانا:
        النص: "اختبار الدفعة الرابعة"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "video_btn"
        النص: "📹 اتصال فيديو"
        اللون: أخضر
        عند_الضغط:
            اتصال_فيديو "room_1"

    انشئ زر:
        المعرف: "push_btn"
        النص: "🔔 إشعارات push"
        اللون: برتقالي
        عند_الضغط:
            اطلب_إشعارات_push

    انشئ نصا:
