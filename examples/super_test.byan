انا_برنامج
    اسمي: الاختبار الشامل

الكود:
    انشئ نافذة:
        العنوان: الاختبار الشامل
        لون_الخلفية: بنفسجي

    انشئ عنوانا:
        النص: الاختبار الشامل
        الحجم: 24
        اللون: أبيض

    انشئ زر:
        المعرف: "b1"
        النص: "قاعدة بيانات"
        اللون: أخضر
        عند_الضغط:
            اضف_سجل "users" فيه {name: "احمد", age: 25}
            اقرأ_سجلات "users" في: "#out"

    انشئ زر:
        المعرف: "b2"
        النص: "مؤقت"
        اللون: برتقالي
        عند_الضغط:
            اعرض_في "بدأ المؤقت" في: "#out"
            كل 2 ثانية:
                اعرض_في "تكة" في: "#out"

    انشئ زر:
        المعرف: "b3"
        النص: "حركة"
        اللون: وردي
        عند_الضغط:
            حرّك "#out" إلى (100, 50) في: 1 ثانية

    انشئ زر:
        المعرف: "b4"
        النص: "أضف عنصر"
        اللون: أزرق
        عند_الضغط:
            ضيف_عنصر "p" في "#container"
            اعرض_في "تم إضافة عنصر" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة هنا"
        الحجم: 20
