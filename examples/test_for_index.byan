انا_برنامج
    اسمي: "اختبار فهرس"

الكود:
    انشئ نافذة:
        العنوان: "اختبار"
        لون_الخلفية: بنفسجي

    انشئ عنوانا:
        النص: "اختبار لكل_بفهرس"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "btn"
        النص: "اضغط"
        اللون: أخضر
        عند_الضغط:
            متغير اسامي = ["احمد", "محمد", "علي"]
            لكل_بفهرس i, اسم في اسامي:
                اعرض_في "{i}: {اسم}" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 18
        اللون: أسود
