انا_برنامج
    اسمي: "اختبار 43-47"

الكود:
    انشئ نافذة:
        العنوان: "Test"
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: "اختبار 43-47"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "btn"
        النص: "اختبر"
        اللون: أخضر
        عند_الضغط:
            ثابت PI = 3.14
            متغير س = لا_شيء
            متغير ن = س || 10
            اعرض_في "PI={PI}, ن={ن}" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أسود
