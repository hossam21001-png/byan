انا_برنامج
    اسمي: "اختبار الاستيراد"

الكود:
    استورد "utils.byan"

    انشئ نافذة:
        العنوان: "Import"
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: "اختبار الاستيراد"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "btn"
        النص: "اختبر"
        اللون: أخضر
        عند_الضغط:
            متغير ن = جمع(5, 3)
            اعرض_في "5 + 3 = {ن}" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 18
        اللون: أسود
