انا_برنامج
    اسمي: "اختبار Math"

الكود:
    انشئ نافذة:
        العنوان: "Math"
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: "دوال الرياضيات"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "btn"
        النص: "احسب"
        اللون: أخضر
        عند_الضغط:
            اعرض_في "جذر 16 = {جذر(16)}" في: "#out"
            اعرض_في "قوة 2^8 = {قوة(2, 8)}" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أسود
