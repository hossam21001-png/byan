انا_برنامج
    اسمي: "اختبار الدفعة 2"

الكود:
    انشئ نافذة:
        العنوان: "Batch 2"
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: "اختبار الدفعة التانية"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "sound_btn"
        النص: "🔊 صوت"
        اللون: أخضر
        عند_الضغط:
            شغل_صوت "https://actions.google.com/sounds/v1/alarms/beep_short.ogg"

    انشئ زر:
        المعرف: "notify_btn"
        النص: "🔔 إشعار"
        اللون: برتقالي
        عند_الضغط:
            أظهر_إشعار "مرحبا" "أهلاً بك في بيان"

    انشئ زر:
        المعرف: "copy_btn"
        النص: "📋 انسخ"
        اللون: بنفسجي
        عند_الضغط:
            انسخ_للحافظة "نص تجريبي من بيان"

    انشئ زر:
        المعرف: "paste_btn"
        النص: "📋 الصق"
        اللون: أزرق
        عند_الضغط:
            الصق

    انشئ زر:
        المعرف: "download_btn"
        النص: "⬇️ حمل"
        اللون: أحمر
        عند_الضغط:
            حمل "https://example.com/file.pdf" "test.pdf"
