انا_برنامج
    اسمي: "اختبار Lambda"

الكود:
    انشئ نافذة:
        العنوان: "Lambda"
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: "اختبار الدوال المجهولة"
        الحجم: 24
        اللون: أسود

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 18
        اللون: أسود

    انشئ زر:
        المعرف: "btn"
        النص: "اختبر"
        اللون: أخضر
        عند_الضغط:
            متغير مضاعف = (س) => س * 2
            متغير مجموع = (أ, ب) => أ + ب
            اعرض_في "مضاعف 5 = {مضاعف(5)}" في: "#out"
