انا_برنامج
    اسمي: "اختبار المنطق"
    أنظمة_التشغيل: "الكل"

الكود:
    أنشئ_ملفًا:
        الاسم: "index.html"
        المسار: "./"
        المحتوى:
            """
            <!DOCTYPE html>
            <html lang="ar" dir="rtl">
            <head>
                <meta charset="UTF-8">
                <title>اختبار المنطق</title>
                <link rel="stylesheet" href="style.css">
            </head>
            <body>
                <h1>اختبار المتغيرات والمنطق</h1>
                <button id="check">تحقق من العمر</button>
                <p id="output"></p>
            </body>
            </html>
            """

    أنشئ_ملفًا:
        الاسم: "style.css"
        المسار: "./"
        المحتوى:
            """
            body {
                font-family: 'Cairo', sans-serif;
                background: linear-gradient(135deg, #43cea2, #185a9d);
                color: white;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
            }
            h1 { font-size: 32px; }
            button {
                padding: 15px 40px;
                font-size: 20px;
                border-radius: 12px;
                border: none;
                cursor: pointer;
                background: white;
                color: #185a9d;
                font-weight: bold;
                margin-top: 20px;
            }
            #output {
                font-size: 28px;
                margin-top: 30px;
                font-weight: bold;
            }
            """

    أنشئ_ملفًا:
        الاسم: "script.js"
        المسار: "./"
        المحتوى:
            """
            // ملف فارغ
            """

    أنشئ زر:
        المعرف: "check"
        النص: "تحقق من العمر"
        عند_الضغط:
            متغير العمر = 25
            لو العمر > 18:
                اعرض_في "بالغ ✅" في: "#output"
            وإلا:
                اعرض_في "صغير 👶" في: "#output"
