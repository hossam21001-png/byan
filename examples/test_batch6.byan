انا_برنامج
    اسمي: "اختبار الدفعة 6"

الكود:
    انشئ نافذة:
        العنوان: "Batch 6"
        لون_الخلفية: بنفسجي

    انشئ عنوانا:
        النص: "اختبار الدفعة السادسة"
        الحجم: 24
        اللون: أسود

    صنف شخص:
        دالة تحدث:
            ارجع "أنا شخص"

    انشئ زر:
        المعرف: "class_btn"
        النص: "🏛️ صنف"
        اللون: أخضر
        عند_الضغط:
            غير_متزامن دالة تحميل:
                اعرض_في "تم التحميل" في: "#out"

    انشئ زر:
        المعرف: "match_btn"
        النص: "🎯 Pattern"
        اللون: برتقالي
        عند_الضغط:
            طابق "احمد" مع:
                حالة "احمد":
                    اعرض_في "أهلاً احمد" في: "#out"
                حالة "محمد":
                    اعرض_في "أهلاً محمد" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أسود
