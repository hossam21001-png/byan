انا_برنامج
    اسمي: "اختبار Nested"

الكود:
    دالة خارجية(س):
        دالة داخلية(ص):
            ارجع ص * 2
        ارجع داخلية(س) + 1

    انشئ نافذة:
        العنوان: "Nested"
        لون_الخلفية: أزرق

    انشئ زر:
        المعرف: "btn"
        النص: "اختبر"
        اللون: أخضر
        عند_الضغط:
            اعرض_في "النتيجة: {خارجية(5)}" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أسود
