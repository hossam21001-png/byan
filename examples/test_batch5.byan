انا_برنامج
    اسمي: "اختبار الدفعة 5"

الكود:
    انشئ نافذة:
        العنوان: "Batch 5"
        لون_الخلفية: أزرق داكن

    انشئ عنوانا:
        النص: "اختبار الدفعة الخامسة"
        الحجم: 24
        اللون: أبيض

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أبيض

    انشئ زر:
        المعرف: "ai_btn"
        النص: "🤖 AI محلي"
        اللون: أخضر
        عند_الضغط:
            اسأل_ai_محلي "ما هي عاصمة مصر؟" في: "#out"

    انشئ زر:
        المعرف: "wallet_btn"
        النص: "💰 اتصال محفظة"
        اللون: برتقالي
        عند_الضغط:
            اتصال_محفظة "ethereum"

    انشئ زر:
        المعرف: "3d_btn"
        النص: "🎮 مشهد 3D"
        اللون: بنفسجي
        عند_الضغط:
            انشئ_مشهد_3d:
                المعرف: "my_scene"

    انشئ زر:
        المعرف: "ar_btn"
        النص: "🥽 AR"
        اللون: أزرق
        عند_الضغط:
            انشئ_ar:
                المعرف: "my_ar"
