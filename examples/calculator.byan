انا_برنامج
    اسمي: آلة حاسبة
    أنظمة_التشغيل: "الكل"

الكود:
    انشئ نافذة:
        العنوان: آلة حاسبة
        لون_الخلفية: أزرق

    انشئ عنوانا:
        المعرف: "title"
        النص: آلة حاسبة بسيطة
        الحجم: 28

    انشئ مدخلا:
        المعرف: "num1"
        النص: "الرقم الأول"

    انشئ مدخلا:
        المعرف: "num2"
        النص: "الرقم الثاني"

    انشئ زر:
        المعرف: "add"
        النص: "اجمع"
        اللون: أخضر
        عند_الضغط:
            متغير أ = اقرأ_قيمة("#num1")
            متغير ب = اقرأ_قيمة("#num2")
            متغير الناتج = أ + ب
            اعرض_في الناتج في: "#result"

    انشئ زر:
        المعرف: "sub"
        النص: "اطرح"
        اللون: أحمر
        عند_الضغط:
            متغير أ = اقرأ_قيمة("#num1")
            متغير ب = اقرأ_قيمة("#num2")
            متغير الناتج = أ - ب
            اعرض_في الناتج في: "#result"

    انشئ زر:
        المعرف: "mul"
        النص: "اضرب"
        اللون: برتقالي
        عند_الضغط:
            متغير أ = اقرأ_قيمة("#num1")
            متغير ب = اقرأ_قيمة("#num2")
            متغير الناتج = أ * ب
            اعرض_في الناتج في: "#result"

    انشئ نصا:
        المعرف: "result"
        النص: "النتيجة هتظهر هنا"
        الحجم: 24
