انا_برنامج
    اسمي: "اختبار 53-57"

الكود:
    انشئ نافذة:
        العنوان: "Batch 53-57"
        لون_الخلفية: بنفسجي

    انشئ عنوانا:
        النص: "Array + JSON + Regex"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "btn"
        النص: "اختبر"
        اللون: أخضر
        عند_الضغط:
            متغير ارقام = [1, 2, 3, 4, 5]
            متغير اكتر = صفّي(ارقام)
            متغير النص = حوّل_JSON(ارقام)
            متغير السالب = طابق_نمط("123", "[0-9]+")
            اعرض_في "JSON: {النص}" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أسود
