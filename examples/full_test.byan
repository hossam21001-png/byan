انا_برنامج
    اسمي: اختبار كامل

الكود:
    انشئ نافذة:
        العنوان: اختبار كل الميزات
        لون_الخلفية: أزرق

    انشئ عنوانا:
        النص: اختبار شامل
        الحجم: 24

    انشئ زر:
        المعرف: "test1"
        النص: "اختبر AND و OR"
        عند_الضغط:
            متغير س = 5
            متغير ص = 10
            لو س < ص و س > 0:
                اعرض_في "الشرطين صح ✅" في: "#output"
            وإلا:
                اعرض_في "شرط غلط ❌" في: "#output"

    انشئ زر:
        المعرف: "test2"
        النص: "اختبر القسمة"
        عند_الضغط:
            متغير أ = 20
            متغير ب = 4
            اعرض_في أ / ب في: "#output"

    انشئ زر:
        المعرف: "test3"
        النص: "اختبر الطول"
        عند_الضغط:
            متغير أرقام = [1, 2, 3, 4, 5]
            اعرض_في طول(أرقام) في: "#output"

    انشئ نصا:
        المعرف: "output"
        النص: "النتيجة هنا"
