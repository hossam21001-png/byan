انا_برنامج
    اسمي: "اختبار Auth"

الكود:
    انشئ نافذة:
        العنوان: "Auth"
        لون_الخلفية: أخضر

    انشئ عنوانا:
        النص: "اختبار المصادقة"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "login"
        النص: "تسجيل دخول"
        اللون: أخضر
        عند_الضغط:
            تسجيل_دخول "احمد" "123456"

    انشئ زر:
        المعرف: "logout"
        النص: "تسجيل خروج"
        اللون: أحمر
        عند_الضغط:
            تسجيل_خروج

    انشئ زر:
        المعرف: "register"
        النص: "حساب جديد"
        اللون: أزرق
        عند_الضغط:
            حساب_جديد "محمد" "abcdef"
