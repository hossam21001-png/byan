انا_برنامج
    اسمي: اختبار كل الميزات

الكود:
    انشئ نافذة:
        العنوان: اختبار شامل
        لون_الخلفية: بنفسجي

    انشئ عنوانا:
        النص: اختبار كل الميزات
        الحجم: 24
        اللون: أبيض

    انشئ صورة:
        المعرف: "img1"
        المسار: "https://via.placeholder.com/200"
        العرض: 200

    انشئ قائمة_منسدلة:
        المعرف: "colors"
        خيار: "أحمر"
        خيار: "أخضر"
        خيار: "أزرق"

    انشئ زر:
        المعرف: "b1"
        النص: "اختبر أضف"
        اللون: أخضر
        عند_الضغط:
            متغير أرقام = [1, 2, 3]
            أضف(أرقام, 4)
            أضف(أرقام, 5)
            اعرض_في طول(أرقام) في: "#out"

    انشئ زر:
        المعرف: "b2"
        النص: "اختبر احذف"
        اللون: أحمر
        عند_الضغط:
            متغير أرقام = [10, 20, 30, 40]
            احذف_عنصر(أرقام, 1)
            اعرض_في أرقام[0] في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة هتظهر هنا"
        الحجم: 20
