انا_برنامج
    اسمي: "اختبار String"

الكود:
    انشئ نافذة:
        العنوان: "String"
        لون_الخلفية: بنفسجي

    انشئ عنوانا:
        النص: "دوال النصوص"
        الحجم: 24
        اللون: أسود

    انشئ زر:
        المعرف: "btn"
        النص: "اختبر"
        اللون: أخضر
        عند_الضغط:
            متغير نص_كبير = يحتوي("مرحبا بك", "مرحبا")
            اعرض_في "يحتوي: {نص_كبير}" في: "#out"

    انشئ نصا:
        المعرف: "out"
        النص: "النتيجة"
        الحجم: 16
        اللون: أسود
