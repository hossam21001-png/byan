انا_برنامج
    اسمي: "تطبيق واجهة كامل"
    أنظمة_التشغيل: "الكل"

الكود:
    # ===== المنطق =====
    متغير عداد = 0
    
    دالة زيادة():
        عداد = عداد + 1
        ارجع عداد
    
    اعرض("=== تطبيق Byan ===")
    
    # ===== الواجهة =====
    انشئ عنوانا:
        المعرف: "title"
        النص: "تطبيق Byan"
    
    انشئ مدخلا:
        المعرف: "name-input"
        النص: "اكتب اسمك"
    
    انشئ زر:
        المعرف: "greet-btn"
        النص: "تحية"
        عند_الضغط:
            اعرض_في "أهلاً بك!" في: "#output"
    
    انشئ زر:
        المعرف: "count-btn"
        النص: "زيادة العداد"
        عند_الضغط:
            اعرض_في "0" في: "#counter"
    
    انشئ مدخلا:
        المعرف: "output"
        النص: ""
    
    انشئ مدخلا:
        المعرف: "counter"
        النص: "0"
