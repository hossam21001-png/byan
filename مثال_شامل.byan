انا_برنامج
    اسمي: "مثال شامل"
    أنظمة_التشغيل: "الكل"

الكود:
    متغير مجموع = 10 + 20
    اطبع(مجموع)

    متغير عمر = 25
    إذا عمر > 18:
        اطبع("بالغ")
    وإلا:
        اطبع("قاصر")

    لكل عدد في [1, 2, 3]:
        اطبع(عدد)

    دالة مربع(س):
        ارجع س * س

    اطبع(مربع(5))
